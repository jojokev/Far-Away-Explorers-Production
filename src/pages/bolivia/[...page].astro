---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import defaultImage from "../../assets/banners/panoramico-bolivia.webp";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async ({ paginate }) => {
  const res = await fetch("https://wp.farawayexplorers.com/wp-json/wp/v2/tour?categories=10&_embed");
  const data = await res.json();
  return paginate(data, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const basePath = "bolivia";

let yoastHead: string | undefined;
try {
  const yoastRes = await fetch(`https://wp.farawayexplorers.com/wp-json/wp/v2/categories?slug=${basePath}`);
  if (yoastRes.ok) {
    const yoastData = await yoastRes.json();
    yoastHead = yoastData?.[0]?.yoast_head as string | undefined;
  }
} catch (e) {}

const category = {
  name:        "Bolivia",
  description: "Bolivia ofrece una mezcla única de cultura andina, ciudades coloniales y paisajes extremos. Desde el Salar de Uyuni y el lago Titicaca hasta La Paz y Sucre, es ideal para aventura, historia y naturaleza.",
  total:       page.total,
};

const seo = {
  title: `Tours en ${category.name} | Far Away Explorers`,
  description: category.description,
  canonical: page.currentPage === 1
    ? `https://farawayexplorers.com/${basePath}`
    : `https://farawayexplorers.com/${basePath}/${page.currentPage}`,
  ogImage: defaultImage.src,
  yoastHead: page.currentPage === 1 ? yoastHead : undefined,
};
---

<Layout {...seo}>
  <div class="category-page">

    <section class="cat-hero">
      <div class="cat-hero__bg" aria-hidden="true">
        <img src={defaultImage.src} alt="" class="cat-hero__bg-img" />
        <div class="cat-hero__bg-overlay"></div>
        <div class="cat-hero__bg-dots"></div>
      </div>
      <div class="container">
        <div class="cat-hero__inner">
          <h1 class="cat-hero__title">{category.name}</h1>
          <p class="cat-hero__desc">{category.description}</p>
        </div>
      </div>
    </section>

    <div class="cat-topbar">
      <div class="container">
        <div class="cat-topbar__inner">
          <nav class="cat-topbar__breadcrumb" aria-label="Breadcrumb">
            <a href="/" class="cat-topbar__breadcrumb-link">Inicio</a>
            <Icon name="ion:chevron-forward" class="cat-topbar__breadcrumb-sep" aria-hidden="true" />
            <a href="/destinos" class="cat-topbar__breadcrumb-link">Destinos</a>
            <Icon name="ion:chevron-forward" class="cat-topbar__breadcrumb-sep" aria-hidden="true" />
            <span class="cat-topbar__breadcrumb-current">{category.name}</span>
          </nav>
          <div class="cat-topbar__right">
            <p class="cat-topbar__count">
              <strong>{category.total}</strong> tours disponibles
            </p>
            <div class="cat-topbar__view-toggle" role="group" aria-label="Cambiar vista">
              <button type="button" class="cat-topbar__view-btn cat-topbar__view-btn--active" aria-label="Vista cuadrícula" data-view="grid">
                <Icon name="ion:grid-outline" aria-hidden="true" />
              </button>
              <button type="button" class="cat-topbar__view-btn" aria-label="Vista lista" data-view="list">
                <Icon name="ion:list-outline" aria-hidden="true" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="cat-results">
      <div class="container">
        <div class="cat-grid" id="tours-grid">
          {page.data.map((tour: any) => (
            <article class="cat-card">
              <a href={`/tour/${tour.slug}`} class="cat-card__img-link" tabindex="-1" aria-hidden="true">
                <img
                  src={tour._embedded?.["wp:featuredmedia"]?.[0]?.media_details?.sizes?.medium_large?.source_url ?? defaultImage.src}
                  alt={tour.title_plain}
                  class="cat-card__img"
                  loading="lazy"
                />
              </a>
              <div class="cat-card__body">
                <div class="cat-card__meta">
                  <span class="cat-card__meta-item">
                    <Icon name="ion:time-outline" aria-hidden="true" />
                    {tour.acf.duracion}
                  </span>
                  <span class="cat-card__meta-item">
                    <Icon name="ion:people-outline" aria-hidden="true" />
                    {tour.acf.group}
                  </span>
                </div>
                <h2 class="cat-card__title">
                  <a href={`/tour/${tour.slug}`} class="cat-card__title-link">
                    {tour.title_plain}
                  </a>
                </h2>
                <div class="cat-card__footer">
                  {tour.acf.price ? (
                    <div class="cat-card__price-block">
                      <span class="cat-card__price-from">Desde</span>
                      <span class="cat-card__price">${tour.acf.price}</span>
                      <span class="cat-card__price-per">/ persona</span>
                    </div>
                  ) : (
                    <a
                      href={`https://wa.me/51900086730?text=${encodeURIComponent(`Hola Far Away Explorers, me gustaría saber más de los precios del tour ${tour.title_plain} - https://farawayexplorers.com/tour/${tour.slug}`)}`}
                      class="btn-whatsapp"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Icon name="ion:logo-whatsapp" aria-hidden="true" />
                      Consultar precio
                    </a>
                  )}
                  <a href={`/tour/${tour.slug}`} class="cat-card__cta">
                    Ver tour
                    <Icon name="ion:arrow-forward" class="cat-card__cta-icon" aria-hidden="true" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        {page.lastPage > 1 && (
          <nav class="cat-pagination" aria-label="Paginación de tours">
            {page.url.prev ? (
              <a href={page.url.prev} class="cat-pagination__btn" aria-label="Anterior">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              </a>
            ) : (
              <span class="cat-pagination__btn cat-pagination__btn--disabled">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              </span>
            )}
            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) =>
              num === page.currentPage ? (
                <span class="cat-pagination__btn cat-pagination__btn--active" aria-current="page">{num}</span>
              ) : (
                <a href={num === 1 ? `/${basePath}` : `/${basePath}/${num}`} class="cat-pagination__btn">{num}</a>
              )
            )}
            {page.url.next ? (
              <a href={page.url.next} class="cat-pagination__btn" aria-label="Siguiente">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
            ) : (
              <span class="cat-pagination__btn cat-pagination__btn--disabled">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            )}
          </nav>
        )}
      </div>
    </section>

  </div>
</Layout>

<style lang="scss">
  @use '../../styles/categories-page.scss';
</style>

<script>
  const viewBtns = document.querySelectorAll(".cat-topbar__view-btn");
  const grid     = document.getElementById("tours-grid");
  viewBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      viewBtns.forEach((b) => b.classList.remove("cat-topbar__view-btn--active"));
      btn.classList.add("cat-topbar__view-btn--active");
      grid?.classList.toggle("cat-grid--list", btn.getAttribute("data-view") === "list");
    });
  });
</script>
