---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import defaultImage from "../../assets/banners/panoramico-trekking.webp";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async ({ paginate }) => {
  const res = await fetch("https://wp.farawayexplorers.com/wp-json/wp/v2/blog?per_page=100&_embed");
  const data = await res.json();

  const blogs = data.map((post: any) => {
    const featured = post._embedded?.["wp:featuredmedia"]?.[0]?.media_details?.sizes?.medium_large?.source_url;
    const categories = post._embedded?.["wp:term"]?.[0];
    const date = new Date(post.date);
    const formattedDate = date.toLocaleDateString("es-PE", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase();

    return {
      title: post.title.rendered,
      date: formattedDate,
      category: categories?.[0]?.name ?? "Blog",
      readTime: `${Math.max(1, Math.ceil((post.content?.rendered?.replace(/<[^>]*>/g, "").split(/\s+/).length ?? 0) / 200))} min de lectura`,
      description: post.excerpt.rendered.replace(/<[^>]*>/g, "").trim(),
      image: featured ?? defaultImage.src,
      link: `/blog/${post.slug}`,
    };
  });

  return paginate(blogs, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const basePath = "blog";

let yoastHead: string | undefined;
try {
  const yoastRes = await fetch('https://wp.farawayexplorers.com/wp-json/wp/v2/pages?slug=blog');
  if (yoastRes.ok) {
    const yoastData = await yoastRes.json();
    const rawHead = yoastData?.[0]?.yoast_head as string | undefined;
    yoastHead = rawHead?.replace(/wp\.farawayexplorers\.com/g, 'farawayexplorers.com');
  }
} catch (e) {}

const seo = {
  title: "Blog de Viajes | Far Away Explorers",
  description: "Descubre consejos, guías e historias de viaje por Perú y Bolivia. Inspírate para tu próxima aventura con Far Away Explorers.",
  canonical: page.currentPage === 1
    ? "https://farawayexplorers.com/blog"
    : `https://farawayexplorers.com/blog/${page.currentPage}`,
  ogImage: defaultImage.src,
  yoastHead: page.currentPage === 1 ? yoastHead : undefined,
};
---

<Layout {...seo}>
  <div class="blog-page">

    <!-- Hero -->
    <section class="blog-hero">
      <div class="blog-hero__bg" aria-hidden="true">
        <img src={defaultImage.src} alt="" class="blog-hero__bg-img" />
        <div class="blog-hero__bg-overlay"></div>
        <div class="blog-hero__bg-dots"></div>
      </div>
      <div class="container">
        <div class="blog-hero__inner">
          <h1 class="blog-hero__title">Blog</h1>
          <p class="blog-hero__desc">
            Consejos de viaje, cultura local y guías de aventura para que aproveches al máximo tu experiencia en Perú.
          </p>
        </div>
      </div>
    </section>

    <!-- Breadcrumb + count -->
    <div class="blog-topbar">
      <div class="container">
        <div class="blog-topbar__inner">
          <nav class="blog-topbar__breadcrumb" aria-label="Navegación de ruta">
            <a href="/" class="blog-topbar__breadcrumb-link">Inicio</a>
            <Icon name="ion:chevron-forward" class="blog-topbar__breadcrumb-sep" aria-hidden="true" />
            <span class="blog-topbar__breadcrumb-current">Blog</span>
          </nav>
          <p class="blog-topbar__count">
            <strong>{page.total}</strong> artículos
          </p>
        </div>
      </div>
    </div>

    <!-- Grid -->
    <section class="blog-results">
      <div class="container">
        <div class="blog-grid">
          {page.data.map((blog: any) => (
            <article class="blog-card">

              <a href={blog.link} class="blog-card__img-link" tabindex="-1" aria-hidden="true">
                <img
                  src={blog.image}
                  alt={blog.title}
                  class="blog-card__img"
                  loading="lazy"
                />
                <span class="blog-card__category">{blog.category}</span>
              </a>

              <div class="blog-card__body">

                <div class="blog-card__meta">
                  <span class="blog-card__date">
                    <Icon name="ion:calendar-outline" class="blog-card__meta-icon" aria-hidden="true" />
                    {blog.date}
                  </span>
                  <span class="blog-card__read-time">
                    <Icon name="ion:time-outline" class="blog-card__meta-icon" aria-hidden="true" />
                    {blog.readTime}
                  </span>
                </div>

                <h2 class="blog-card__title">
                  <a href={blog.link} class="blog-card__title-link" set:html={blog.title} />
                </h2>

                <p class="blog-card__desc">{blog.description}</p>

                <a href={blog.link} class="blog-card__cta">
                  Leer artículo
                  <Icon name="ion:arrow-forward" class="blog-card__cta-icon" aria-hidden="true" />
                </a>

              </div>
            </article>
          ))}
        </div>

        {page.lastPage > 1 && (
          <nav class="blog-pagination" aria-label="Paginación del blog">
            {page.url.prev ? (
              <a href={page.url.prev} class="blog-pagination__btn" aria-label="Anterior">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              </a>
            ) : (
              <span class="blog-pagination__btn blog-pagination__btn--disabled">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              </span>
            )}
            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) =>
              num === page.currentPage ? (
                <span class="blog-pagination__btn blog-pagination__btn--active" aria-current="page">{num}</span>
              ) : (
                <a href={num === 1 ? `/${basePath}` : `/${basePath}/${num}`} class="blog-pagination__btn">{num}</a>
              )
            )}
            {page.url.next ? (
              <a href={page.url.next} class="blog-pagination__btn" aria-label="Siguiente">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
            ) : (
              <span class="blog-pagination__btn blog-pagination__btn--disabled">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            )}
          </nav>
        )}
      </div>
    </section>

  </div>
</Layout>

<style lang="scss">
  @use '../../styles/abstract/variables' as *;
  @use '../../styles/abstract/mixins'   as *;

  // ─── Variables locales ──────────────────────────────────────────────────────
  $blog-card-img-h:        220px;
  $blog-card-radius:       12px;
  $blog-card-shadow:       0 2px 12px rgba(0, 0, 0, 0.06);
  $blog-card-shadow-hover: 0 12px 32px rgba(0, 0, 0, 0.12);
  $blog-color-text:        #151515;
  $blog-color-muted:       rgba(80, 80, 80, 0.82);
  $blog-topbar-bg:         #faf8f5;
  $blog-hero-min-h:        400px;

  // ═══════════════════════════════════════════════════════════════════════════
  // HERO
  // ═══════════════════════════════════════════════════════════════════════════
  .blog-hero {
    position: relative;
    min-height: $blog-hero-min-h;
    display: flex;
    align-items: flex-end;
    padding-bottom: 3.5rem;
    overflow: hidden;
  }

  .blog-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .blog-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.04);
    transition: transform 8s ease;

    .blog-hero:hover & { transform: scale(1); }
  }

  .blog-hero__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.48) 55%, rgba($color-primary, 0.22) 100%);
  }

  .blog-hero__bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }

  .blog-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 4rem;
  }

  .blog-hero__title {
    font-size: 2.75rem;
    font-weight: $font-weight-bold;
    line-height: 1.08;
    color: $color-white;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);

    @include md { font-size: 3.5rem; }

    &::after {
      content: '';
      display: block;
      width: 3.5rem;
      height: 3px;
      background-color: $color-primary;
      border-radius: 2px;
      margin-top: 0.75rem;
    }
  }

  .blog-hero__desc {
    font-size: $font-size-base;
    font-weight: $font-weight-medium;
    line-height: 1.7;
    color: rgba($color-white, 0.82);
    max-width: 600px;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // TOPBAR
  // ═══════════════════════════════════════════════════════════════════════════
  .blog-topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: $blog-topbar-bg;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  }

  .blog-topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-block: 0.75rem;
  }

  .blog-topbar__breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .blog-topbar__breadcrumb-link {
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: $blog-color-muted;
    transition: color 0.2s ease;

    &:hover { color: $color-primary; }
  }

  .blog-topbar__breadcrumb-sep {
    font-size: 0.7rem;
    color: rgba(0, 0, 0, 0.25);
    flex-shrink: 0;
  }

  .blog-topbar__breadcrumb-current {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: $color-primary;
  }

  .blog-topbar__count {
    font-size: $font-size-sm;
    color: $blog-color-muted;

    strong {
      color: $blog-color-text;
      font-weight: $font-weight-semibold;
    }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // RESULTS
  // ═══════════════════════════════════════════════════════════════════════════
  .blog-results {
    padding-block: 2.5rem 4.5rem;
    @include md { padding-block: 3rem 5rem; }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // GRID
  // ═══════════════════════════════════════════════════════════════════════════
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;

    @include sm { grid-template-columns: repeat(2, 1fr); }
    @include lg { grid-template-columns: repeat(3, 1fr); }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // CARD
  // ═══════════════════════════════════════════════════════════════════════════
  .blog-card {
    display: flex;
    flex-direction: column;
    border-radius: $blog-card-radius;
    overflow: hidden;
    background-color: $color-white;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: $blog-card-shadow;
    transition:
      box-shadow   0.3s ease,
      transform    0.3s ease,
      border-color 0.3s ease;

    &:hover {
      box-shadow: $blog-card-shadow-hover;
      transform: translateY(-4px);
      border-color: rgba($color-primary, 0.18);
    }
  }

  // ─── Image ──────────────────────────────────────────────────────────────────
  .blog-card__img-link {
    position: relative;
    display: block;
    overflow: hidden;
    flex-shrink: 0;
    height: $blog-card-img-h;
  }

  .blog-card__img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
    will-change: transform;
    display: block;

    .blog-card:hover & { transform: scale(1.05); }
  }

  .blog-card__category {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: $color-primary;
    color: $color-white;
    font-size: 0.7rem;
    font-weight: $font-weight-bold;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.625rem;
    border-radius: 99px;
  }

  // ─── Body ───────────────────────────────────────────────────────────────────
  .blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem 1.25rem 1.5rem;
    flex: 1;
  }

  // ─── Meta ───────────────────────────────────────────────────────────────────
  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .blog-card__date,
  .blog-card__read-time {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: rgba($blog-color-text, 0.55);
    letter-spacing: 0.02em;
  }

  .blog-card__date {
    color: $color-primary;
    font-weight: $font-weight-semibold;
  }

  .blog-card__meta-icon {
    width: 0.8rem;
    height: 0.8rem;
    flex-shrink: 0;
  }

  // ─── Title ──────────────────────────────────────────────────────────────────
  .blog-card__title {
    font-size: 1rem;
    font-weight: $font-weight-semibold;
    line-height: 1.4;
    color: $blog-color-text;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__title-link {
    color: inherit;
    transition: color 0.25s ease;

    &:hover { color: $color-primary; }

    &:focus-visible {
      outline: 2px solid rgba($color-primary, 0.6);
      outline-offset: 2px;
      border-radius: 2px;
    }
  }

  // ─── Description ────────────────────────────────────────────────────────────
  .blog-card__desc {
    font-size: $font-size-sm;
    line-height: 1.65;
    color: rgba($blog-color-text, 0.65);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  // ─── CTA ────────────────────────────────────────────────────────────────────
  .blog-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.375rem;
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: $color-primary;
    border-bottom: 1.5px solid transparent;
    padding-bottom: 1px;
    width: fit-content;
    transition:
      border-color 0.25s ease,
      gap          0.25s ease;

    &:hover {
      border-bottom-color: $color-primary;
      gap: 0.5rem;
    }
  }

  .blog-card__cta-icon {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.25s ease;

    .blog-card__cta:hover & { transform: translateX(2px); }
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // PAGINATION
  // ═══════════════════════════════════════════════════════════════════════════
  .blog-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    margin-top: 2.5rem;

    &:empty { display: none; }
  }

  .blog-pagination__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0.25rem 0.625rem;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    background-color: $color-white;
    color: $blog-color-text;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color            0.2s ease,
      border-color     0.2s ease,
      transform        0.15s ease;

    &:hover:not(&--disabled):not(&--active) {
      border-color: $color-primary;
      color: $color-primary;
      transform: translateY(-1px);
    }

    &--active {
      background-color: $color-primary;
      color: $color-white;
      border-color: $color-primary;
      font-weight: $font-weight-semibold;
      cursor: default;
    }

    &--disabled {
      opacity: 0.35;
      cursor: not-allowed;
      pointer-events: none;
    }

    svg {
      width: 0.875rem;
      height: 0.875rem;
      stroke: currentColor;
      stroke-width: 2.5;
      fill: none;
    }
  }
</style>
