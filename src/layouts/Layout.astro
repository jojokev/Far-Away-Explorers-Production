---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.scss';

const { title = "Far Away Explorers" } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preload" href="/fonts/Montserrat-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Montserrat-Medium.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Montserrat-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Montserrat-Bold.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml">
		<link rel="icon" href="/favicon.ico" sizes="any">
		<link rel="apple-touch-icon" href="/apple-touch-icon.png">
		<title>{title}</title>
		<style>
			/* Oculta el toolbar de Google Translate */
			body > .skiptranslate,
			.goog-te-gadget,
			.goog-te-banner-frame { display: none !important; }
			body { top: 0 !important; }
		</style>
	</head>
	<body>
		<Header background="white"></Header>
		<slot />
		<Footer></Footer>

		<!-- ── Google Translate (oculto) ─────────────────────────────── -->
		<div id="google_translate_element" aria-hidden="true" style="display:none"></div>
		<script is:inline>
			window.googleTranslateElementInit = function () {
				new google.translate.TranslateElement(
					{ pageLanguage: 'es', includedLanguages: 'en,pt', autoDisplay: false },
					'google_translate_element'
				);
			};
			// Elimina el toolbar en cuanto Google lo inyecta
			new MutationObserver(function () {
				document.querySelectorAll('body > .skiptranslate, .goog-te-gadget, .goog-te-banner-frame').forEach(function (el) {
					el.remove();
				});
				if (document.body && document.body.style.top) {
					document.body.style.top = '0px';
				}
			}).observe(document.documentElement, { childList: true, subtree: true });
		</script>
		<script is:inline src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
	</body>
</html>
